# ---------------------------------------------------------------------------
# Four Seasons Guest House - environment settings
# Copy this file to ".env" in the project root and fill in your own values.
# The server reads .env automatically on start. Never commit the real .env.
# ---------------------------------------------------------------------------

# Port the website runs on (http://localhost:4173)
PORT=4173

# Admin panel password at /admin. Change this before you go live.
# You can also change it later inside the admin panel (Content tab).
ADMIN_PASSWORD=change-me-now

# --- Optional: email notifications -----------------------------------------
# Free tier of resend.com (100 emails/day, no card needed).
# Leave both empty to skip email - every booking is still saved in the admin
# panel and in data/notifications.log, and guests get a WhatsApp link.
RESEND_API_KEY=
MAIL_FROM=Four Seasons Chame <bookings@yourdomain.com>

# --- Optional: spam protection (Cloudflare Turnstile, free & unlimited) -----
# Get the two keys from https://dash.cloudflare.com > Turnstile > Add site.
# While both are empty the forms still work and are protected by the honeypot,
# the 3-second time trap and the per-IP rate limit.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
