# Required for the first admin login. Use a unique password of 10+ characters.
ADMIN_PASSWORD=

# Server and booking dates
PORT=4173
BUSINESS_TIMEZONE=Asia/Kathmandu

# Recommended in production
SESSION_SECRET=
